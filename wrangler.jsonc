{
  "name": "book-tracker",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    // Requests to /api/* go to the Worker; everything else is served as static files
    "run_worker_first": ["/api/*"]
  }
}
